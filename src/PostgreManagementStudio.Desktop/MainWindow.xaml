<Window x:Class="PostgreManagementStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PostgreManagementStudio.Desktop"
        mc:Ignorable="d"
    Title="PostgreManagementStudio" Height="450" Width="800">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="PostgreManagementStudio" FontSize="24"/><TextBox x:Name="SqlText" Grid.Row="1" Text="SELECT version();" AcceptsReturn="True" Height="70" Margin="0,16,0,8"/><StackPanel Grid.Row="2"><TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Execute" Click="Execute_Click" Padding="12,6"/><Button Content="Cancel" Click="Cancel_Click" Padding="12,6" Margin="8,0,0,0"/></StackPanel></StackPanel><TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0"/></Grid>
</Window>
