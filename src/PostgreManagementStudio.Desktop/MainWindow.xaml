<Window x:Class="PostgreManagementStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PostgreManagementStudio.Desktop"
        Title="PostgreManagementStudio" Height="768" Width="1100"
        MinHeight="640" MinWidth="900"
        Closing="Window_Closing" Loaded="Window_Loaded" PreviewMouseWheel="MainWindow_PreviewMouseWheel">
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" AutomationProperties.Name="Main menu">
      <MenuItem Header="_File">
        <MenuItem Header="_Connect…" Command="{x:Static local:ShellCommands.Connect}"/>
        <MenuItem Header="_Reconnect" Command="{x:Static local:ShellCommands.Reconnect}"/>
        <MenuItem Header="_Disconnect" Command="{x:Static local:ShellCommands.Disconnect}"/>
        <Separator/>
        <MenuItem Header="_New Query" Command="{x:Static local:ShellCommands.NewQuery}" InputGestureText="Ctrl+N"/>
        <MenuItem Header="_Open File…" Command="{x:Static local:ShellCommands.OpenFile}" InputGestureText="Ctrl+O"/>
        <MenuItem Header="_Save" Command="{x:Static local:ShellCommands.Save}" InputGestureText="Ctrl+S"/>
        <MenuItem Header="Save _As…" Command="{x:Static local:ShellCommands.SaveAs}" InputGestureText="Ctrl+Shift+S"/>
        <MenuItem Header="Recent Files" IsEnabled="False" ToolTip="Deferred until recovery persistence is validated."/>
        <Separator/>
        <MenuItem Header="_Close Document" Command="{x:Static local:ShellCommands.CloseDocument}" InputGestureText="Ctrl+W"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z"/>
        <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y"/>
        <Separator/>
        <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X"/>
        <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"/>
        <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"/>
        <MenuItem Header="Select _All" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A"/>
        <Separator/>
        <MenuItem Header="_Find…" Command="{x:Static local:ShellCommands.Find}" InputGestureText="Ctrl+F"/>
        <MenuItem Header="Find _Next" Command="{x:Static local:ShellCommands.FindNext}" InputGestureText="F3"/>
        <MenuItem Header="_Replace…" Command="{x:Static local:ShellCommands.Replace}" InputGestureText="Ctrl+H"/>
        <MenuItem Header="_Go To Line…" Command="{x:Static local:ShellCommands.GoToLine}" InputGestureText="Ctrl+G"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Object Explorer" Command="{x:Static local:ShellCommands.ShowObjectExplorer}" IsCheckable="True" IsChecked="True"/>
        <MenuItem Header="_Results" Command="{x:Static local:ShellCommands.ShowResults}"/>
        <MenuItem Header="_Messages" Command="{x:Static local:ShellCommands.ShowMessages}"/>
        <MenuItem Header="Execution _Plan" Command="{x:Static local:ShellCommands.ShowExecutionPlan}"/>
        <MenuItem Header="_Performance Dashboard" Command="{x:Static local:ShellCommands.PerformanceDashboard}" InputGestureText="Ctrl+Shift+P"/>
        <MenuItem Header="_Blocking Diagnostics" Command="{x:Static local:ShellCommands.BlockingDiagnostics}" InputGestureText="Ctrl+Shift+B"/>
        <Separator/>
        <MenuItem Header="Re_fresh Object Explorer" Command="{x:Static local:ShellCommands.RefreshObjectExplorer}"/>
        <Separator/>
        <MenuItem Header="_Toolbars" IsCheckable="True" IsChecked="True" Click="ToggleToolbars_Click"/>
        <MenuItem Header="_Status Bar" IsCheckable="True" IsChecked="True" Click="ToggleStatusBar_Click"/>
        <Separator/>
        <MenuItem Header="Theme" IsEnabled="True">
          <MenuItem x:Name="LightThemeMenuItem" Header="Light" IsCheckable="True" IsChecked="True" Click="LightTheme_Click"/>
          <MenuItem x:Name="DarkThemeMenuItem" Header="Dark" IsCheckable="True" Click="DarkTheme_Click"/>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Query">
        <MenuItem Header="_Execute" Command="{x:Static local:ShellCommands.Execute}" InputGestureText="F5 / Ctrl+Enter"/>
        <MenuItem Header="_Cancel Executing Query" Command="{x:Static local:ShellCommands.Cancel}" InputGestureText="Esc"/>
        <Separator/>
        <MenuItem Header="_Describe Object" Command="{x:Static local:ShellCommands.DescribeObject}" InputGestureText="Alt+F1"/>
        <Separator/>
        <MenuItem Header="Display _Estimated Execution Plan" Command="{x:Static local:ShellCommands.EstimatedPlan}" InputGestureText="Ctrl+L"/>
        <MenuItem Header="Include _Actual Execution Plan" Command="{x:Static local:ShellCommands.ToggleActualPlan}" IsCheckable="True"
                  IsChecked="{Binding IsChecked, ElementName=ActualPlanButton, Mode=TwoWay}"/>
        <Separator/>
        <MenuItem Header="Change _Connection…" Command="{x:Static local:ShellCommands.ChangeConnection}"/>
        <MenuItem Header="Change _Database" IsEnabled="False" ToolTip="Use the database selector on the query toolbar."/>
        <MenuItem Header="_Transaction Options" IsEnabled="False" ToolTip="Deferred from the release surface until the workflow is complete."/>
      </MenuItem>
      <MenuItem Header="_Database">
        <MenuItem Header="_Import Data…" Command="{x:Static local:ShellCommands.ImportData}"/>
        <MenuItem Header="_Export Data…" Command="{x:Static local:ShellCommands.ExportResults}"
                  ToolTip="Exports the active query result; use Object Explorer Tasks to export a table or view."/>
        <Separator/>
        <MenuItem Header="_Backup…" Command="{x:Static local:ShellCommands.Backup}"/>
        <MenuItem Header="_Restore…" Command="{x:Static local:ShellCommands.Restore}"/>
        <MenuItem Header="_Maintenance…" Command="{x:Static local:ShellCommands.Maintenance}"/>
        <MenuItem Header="_Security Roles…" Command="{x:Static local:ShellCommands.Security}"/>
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Search Objects…" Command="{x:Static local:ShellCommands.SearchObjects}" InputGestureText="Ctrl+Shift+F"/>
        <MenuItem Header="_Index Management…" Command="{x:Static local:ShellCommands.IndexManagement}" InputGestureText="Ctrl+Shift+I"/>
        <MenuItem Header="_Compare Schemas…" Command="{x:Static local:ShellCommands.SchemaCompare}" InputGestureText="Ctrl+Shift+C"/>
        <Separator/>
        <MenuItem Header="Options" IsEnabled="False" ToolTip="No validated options workflow is available yet."/>
      </MenuItem>
      <MenuItem Header="_Window">
        <MenuItem Header="_Close Document" Command="{x:Static local:ShellCommands.CloseDocument}"/>
        <MenuItem Header="Close _All Documents" Command="{x:Static local:ShellCommands.CloseAllDocuments}"/>
        <MenuItem Header="_Next Document" Command="{x:Static local:ShellCommands.NextDocument}" InputGestureText="Ctrl+Tab"/>
        <MenuItem Header="_Previous Document" Command="{x:Static local:ShellCommands.PreviousDocument}" InputGestureText="Ctrl+Shift+Tab"/>
        <Separator/>
        <MenuItem Header="_Reset Window Layout" Click="ResetLayout_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Documentation" Click="Documentation_Click"/>
        <MenuItem Header="_Diagnostics" Click="Diagnostics_Click"/>
        <Separator/>
        <MenuItem Header="_About PostgreManagementStudio" Command="{x:Static local:ShellCommands.About}"/>
      </MenuItem>
    </Menu>

    <ToolBarTray x:Name="ShellToolbars" DockPanel.Dock="Top" IsLocked="True" AutomationProperties.Name="Application toolbars">
      <ToolBar Band="0" BandIndex="0" Header="Standard">
        <Button Command="{x:Static local:ShellCommands.NewQuery}" ToolTip="New Query (Ctrl+N)" AutomationProperties.Name="New query"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;"/></Button>
        <Button Command="{x:Static local:ShellCommands.OpenFile}" ToolTip="Open SQL file (Ctrl+O)" AutomationProperties.Name="Open file"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;"/></Button>
        <Button Command="{x:Static local:ShellCommands.Save}" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save query"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;"/></Button>
        <Separator/>
        <Button Command="{x:Static local:ShellCommands.RefreshObjectExplorer}" ToolTip="Refresh Object Explorer" AutomationProperties.Name="Refresh Object Explorer"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;"/></Button>
        <Button Command="{x:Static local:ShellCommands.Reconnect}" ToolTip="Reconnect to PostgreSQL" AutomationProperties.Name="Reconnect"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;"/></Button>
      </ToolBar>
      <ToolBar Band="1" BandIndex="0" Header="Query">
        <Button x:Name="ConnectionButton" Command="{x:Static local:ShellCommands.ChangeConnection}" MinWidth="150"
                ToolTip="Change the active query connection" AutomationProperties.Name="Active connection">
          <TextBlock x:Name="ConnectionToolbarText" Text="Disconnected" TextTrimming="CharacterEllipsis"/>
        </Button>
        <TextBlock Text="Database:" VerticalAlignment="Center" Margin="6,0,3,0"/>
        <ComboBox x:Name="DatabaseSelector" Width="130" IsEditable="True" IsTextSearchEnabled="True"
                  ToolTip="Database for the active query" AutomationProperties.Name="Active database"
                  LostKeyboardFocus="DatabaseSelector_LostKeyboardFocus"/>
        <Separator/>
        <Button Command="{x:Static local:ShellCommands.Execute}" ToolTip="Execute query (F5 or Ctrl+Enter)" AutomationProperties.Name="Execute query">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,4,0"/><TextBlock Text="Execute"/></StackPanel>
        </Button>
        <Button Command="{x:Static local:ShellCommands.Cancel}" ToolTip="Cancel query (Esc)" AutomationProperties.Name="Cancel query">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" Margin="0,0,4,0"/><TextBlock Text="Cancel"/></StackPanel>
        </Button>
        <Separator/>
        <Button Command="{x:Static local:ShellCommands.EstimatedPlan}" ToolTip="Display estimated execution plan (Ctrl+L)" AutomationProperties.Name="Estimated execution plan"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;"/></Button>
        <ToggleButton x:Name="ActualPlanButton" Command="{x:Static local:ShellCommands.ToggleActualPlan}" ToolTip="Include actual execution plan" AutomationProperties.Name="Include actual execution plan"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;"/></ToggleButton>
      </ToolBar>
    </ToolBarTray>

    <StatusBar x:Name="ShellStatusBar" DockPanel.Dock="Bottom" AutomationProperties.Name="Application status">
      <StatusBarItem><TextBlock x:Name="ConnectionStatusText" Text="Disconnected"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="ServerStatusText" Text="Server: —"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="DatabaseStatusText" Text="Database: —"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="RoleStatusText" Text="Role: —"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="QueryStatusText" Text="Idle"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="RowsStatusText" Text="Rows: —"/></StatusBarItem>
      <Separator/>
      <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="CaretStatusText" Text="Ln 1, Col 1  INS"/></StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ObjectExplorerColumn" Width="260" MinWidth="180"/>
        <ColumnDefinition x:Name="ObjectExplorerSplitterColumn" Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="ObjectExplorerPane" BorderBrush="#B8B8B8" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="8,5">
            <TextBlock x:Name="ObjectExplorerHeader" Text="Object Explorer" FontWeight="SemiBold"/>
          </Border>
      <TreeView x:Name="ObjectExplorerTree" ContextMenuOpening="ObjectExplorerTree_ContextMenuOpening"
                PreviewMouseRightButtonDown="ObjectExplorerTree_PreviewMouseRightButtonDown"
                PreviewMouseLeftButtonDown="ObjectExplorerTree_PreviewMouseLeftButtonDown"
                PreviewMouseMove="ObjectExplorerTree_PreviewMouseMove"
                SelectedItemChanged="ObjectExplorerTree_SelectedItemChanged"
                PreviewKeyDown="ObjectExplorerTree_PreviewKeyDown">
            <TreeView.ContextMenu>
              <ContextMenu/>
            </TreeView.ContextMenu>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E5E5E5"/>
      <TabControl x:Name="QueryTabs" Grid.Column="2" SelectionChanged="QueryTabs_SelectionChanged">
        <TabControl.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Close Document" Command="{x:Static local:ShellCommands.CloseDocument}"/>
            <MenuItem Header="Close Other Tabs" Command="{x:Static local:ShellCommands.CloseOtherDocuments}"/>
            <MenuItem Header="Close All Tabs" Command="{x:Static local:ShellCommands.CloseAllDocuments}"/>
            <Separator/>
            <MenuItem Header="Save" Command="{x:Static local:ShellCommands.Save}"/>
            <MenuItem Header="Change Connection…" Command="{x:Static local:ShellCommands.ChangeConnection}"/>
          </ContextMenu>
        </TabControl.ContextMenu>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
