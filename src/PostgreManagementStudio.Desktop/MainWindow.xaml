<Window x:Class="PostgreManagementStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PostgreManagementStudio.Desktop"
        mc:Ignorable="d"
    Title="PostgreManagementStudio" Height="700" Width="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="PostgreManagementStudio" FontSize="22" Margin="0,0,0,8"/>

        <TextBox x:Name="SqlText" Grid.Row="1" Text="SELECT version();"
                 AcceptsReturn="True" Height="80" Margin="0,0,0,8"
                 FontFamily="Consolas"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ExecuteButton" Content="Execute" Click="Execute_Click" Padding="12,6"/>
            <Button Content="Cancel" Click="Cancel_Click" Padding="12,6" Margin="8,0,0,0"/>
            <ComboBox x:Name="ResultSetSelector" Width="220" Margin="12,0,0,0"
                      SelectionChanged="ResultSetSelector_SelectionChanged"
                      ToolTip="Select result set"/>
        </StackPanel>

        <Border Grid.Row="3" Background="#FFEEF6FF" BorderBrush="#FFCCE0FF" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Idle."/>
                <TextBlock x:Name="CountsText" Text="" Margin="0,4,0,0"/>
                <TextBlock x:Name="MemoryText" Text="" Margin="0,4,0,0"/>
                <TextBlock x:Name="TruncationText" Text="" Foreground="#FF993300" Margin="0,4,0,0" FontWeight="SemiBold"/>
                <TextBlock x:Name="NoticesText" Text="" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ListView x:Name="RowPreview" Grid.Row="4"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  AlternationCount="2">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="#" DisplayMemberBinding="{Binding RowIndex}" Width="80"/>
                        <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="800"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Selection r:" VerticalAlignment="Center"/><TextBox x:Name="StartRowText" Text="0" Width="45" Margin="4,0,4,0"/>
            <TextBox x:Name="EndRowText" Text="0" Width="45" Margin="0,0,8,0"/>
            <TextBlock Text="c:" VerticalAlignment="Center"/><TextBox x:Name="StartColumnText" Text="0" Width="35" Margin="4,0,4,0"/><TextBox x:Name="EndColumnText" Text="0" Width="35" Margin="0,0,8,0"/>
            <ComboBox x:Name="FormatSelector" Width="140" SelectedIndex="0"><ComboBoxItem>PlainText</ComboBoxItem><ComboBoxItem>TabSeparatedValues</ComboBoxItem><ComboBoxItem>Csv</ComboBoxItem><ComboBoxItem>HtmlTable</ComboBoxItem></ComboBox>
            <CheckBox x:Name="IncludeHeaders" Content="Headers" IsChecked="True" Margin="8,0" VerticalAlignment="Center"/><Button Content="Preview" Click="Preview_Click" Padding="10,4"/>
        </StackPanel>
        <TextBox x:Name="SerializationPreview" Grid.Row="6" Height="100" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        <TextBlock x:Name="FooterText" Grid.Row="7" Margin="0,8,0,0" Opacity="0.7"/>
    </Grid>
</Window>
