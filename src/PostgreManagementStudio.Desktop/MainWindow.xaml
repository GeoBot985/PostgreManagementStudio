<Window x:Class="PostgreManagementStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PostgreManagementStudio.Desktop"
        mc:Ignorable="d"
    Title="PostgreManagementStudio" Height="450" Width="800">
    <Grid Margin="24"><StackPanel><TextBlock Text="PostgreManagementStudio" FontSize="24"/><Button Content="Check PostgreSQL version" Click="CheckVersion_Click" Margin="0,20,0,10" Padding="8"/><TextBlock x:Name="ResultText" TextWrapping="Wrap"/></StackPanel></Grid>
</Window>
