<Window x:Class="PostgreManagementStudio.Desktop.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to PostgreSQL" Width="480" Height="540"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.ColumnSpan="2" Text="PostgreSQL connection" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
    <Label Grid.Row="1" Content="_Server:" Target="{Binding ElementName=HostText}"/>
    <TextBox x:Name="HostText" Grid.Row="1" Grid.Column="1" Margin="0,3" Text="localhost"/>
    <Label Grid.Row="2" Content="_Port:" Target="{Binding ElementName=PortText}"/>
    <TextBox x:Name="PortText" Grid.Row="2" Grid.Column="1" Margin="0,3" Text="5432"/>
    <Label Grid.Row="3" Content="_Database:" Target="{Binding ElementName=DatabaseText}"/>
    <TextBox x:Name="DatabaseText" Grid.Row="3" Grid.Column="1" Margin="0,3" Text="postgres"/>
    <Label Grid.Row="4" Content="_Username:" Target="{Binding ElementName=UsernameText}"/>
    <TextBox x:Name="UsernameText" Grid.Row="4" Grid.Column="1" Margin="0,3" Text="postgres"/>
    <Label Grid.Row="5" Content="Pass_word:" Target="{Binding ElementName=PasswordText}"/>
    <PasswordBox x:Name="PasswordText" Grid.Row="5" Grid.Column="1" Margin="0,3"/>
    <Label Grid.Row="6" Content="SS_L mode:" Target="{Binding ElementName=SslModeBox}"/>
    <ComboBox x:Name="SslModeBox" Grid.Row="6" Grid.Column="1" Margin="0,3" SelectedIndex="1">
      <ComboBoxItem Content="Disable"/>
      <ComboBoxItem Content="Prefer"/>
      <ComboBoxItem Content="Require"/>
      <ComboBoxItem Content="VerifyCA"/>
      <ComboBoxItem Content="VerifyFull"/>
    </ComboBox>
    <Label Grid.Row="7" Content="_Environment:" Target="{Binding ElementName=EnvironmentBox}"/>
    <ComboBox x:Name="EnvironmentBox" Grid.Row="7" Grid.Column="1" Margin="0,3" SelectedIndex="0" SelectionChanged="Environment_Changed">
      <ComboBoxItem Content="Local"/>
      <ComboBoxItem Content="Development"/>
      <ComboBoxItem Content="Test"/>
      <ComboBoxItem Content="Staging"/>
      <ComboBoxItem Content="Production"/>
      <ComboBoxItem Content="Custom"/>
    </ComboBox>
    <Label Grid.Row="8" Content="Custom label:" Target="{Binding ElementName=CustomEnvironmentText}"/>
    <TextBox x:Name="CustomEnvironmentText" Grid.Row="8" Grid.Column="1" Margin="0,3" MaxLength="64" IsEnabled="False"/>
    <CheckBox x:Name="ReadOnlyCheck" Grid.Row="9" Grid.Column="1" Margin="0,5"
              Content="Enforce PostgreSQL read-only session"/>
    <StackPanel Grid.Row="10" Grid.Column="1">
      <CheckBox x:Name="SaveProfileCheck" Content="Save connection profile" Checked="SaveProfile_Changed" Unchecked="SaveProfile_Changed"/>
      <CheckBox x:Name="SavePasswordCheck" Margin="18,4,0,0" Content="Protect password in Windows Credential Manager" IsEnabled="False"/>
      <Button x:Name="DeletePasswordButton" Content="Delete saved password" HorizontalAlignment="Left" Margin="18,5,0,0" Padding="8,2" Click="DeletePassword_Click" IsEnabled="False"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" Grid.Row="11" Grid.ColumnSpan="2" Margin="0,12,0,8"
               TextWrapping="Wrap" Foreground="DimGray"
               Text="Passwords remain session-only unless Windows-protected storage is explicitly selected."/>
    <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="TestButton" Content="_Test Connection" Width="112" Margin="0,0,8,0" Click="Test_Click"/>
      <Button x:Name="ConnectButton" Content="_Connect" Width="88" IsDefault="True" Click="Connect_Click"/>
      <Button Content="Cancel" Width="88" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
