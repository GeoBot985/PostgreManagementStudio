<UserControl x:Class="PostgreManagementStudio.Desktop.QueryTabView" PreviewKeyDown="UserControl_KeyDown" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Button Content="Open" Click="Open_Click" Padding="8,4"/><Button Content="Save" Click="Save_Click" Margin="6,0,0,0" Padding="8,4"/><Button Content="Save As" Click="SaveAs_Click" Margin="6,0,0,0" Padding="8,4"/><Button Content="Reload" Click="Reload_Click" Margin="6,0,0,0" Padding="8,4"/><Button Content="Security Roles…" Click="SecurityRoles_Click" Margin="16,0,0,0" Padding="8,4"/><Button Content="Backup Database…" Click="BackupDatabase_Click" Margin="6,0,0,0" Padding="8,4"/><Button Content="Restore Database…" Click="RestoreDatabase_Click" Margin="6,0,0,0" Padding="8,4"/><TextBlock Text="  Database:" VerticalAlignment="Center"/><TextBox x:Name="DatabaseText" Width="140" Margin="6,0,12,0" Text="postgres"/><TextBlock Text="PMS_CONNECTION_STRING" VerticalAlignment="Center" Opacity="0.7"/></StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6"><TextBlock Text="Find:" VerticalAlignment="Center"/><TextBox x:Name="FindText" Width="180" Margin="6,0"/><Button Content="Find next" Click="FindNext_Click" Padding="8,4"/><TextBox x:Name="ReplaceText" Width="180" Margin="6,0"/><Button Content="Replace all" Click="ReplaceAll_Click" Padding="8,4"/><Button Content="Go to line" Click="GoToLine_Click" Margin="6,0" Padding="8,4"/></StackPanel>
  <TextBox x:Name="SqlText" Grid.Row="2" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextChanged="SqlText_TextChanged"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6"><Button x:Name="ExecuteButton" Content="Execute (F5/Ctrl+Enter)" Click="Execute_Click" Padding="10,5"/><Button Content="Cancel (Esc)" Click="Cancel_Click" Margin="8,0,0,0" Padding="10,5"/><TextBlock x:Name="StatusText" Margin="12,6,0,0"/></StackPanel>
  <StackPanel Grid.Row="4"><StackPanel Orientation="Horizontal"><Button Content="Copy" Click="Copy_Click" Padding="8,4"/><Button Content="Copy with headers" Click="CopyWithHeaders_Click" Margin="6,0" Padding="8,4"/><Button Content="Export Results…" Click="Export_Click" Margin="6,0" Padding="8,4"/><TextBlock Text="  Search:" VerticalAlignment="Center"/><TextBox x:Name="ResultSearchText" Width="160" Margin="6,0"/><Button Content="Find" Click="ResultSearch_Click" Padding="8,4"/><Button Content="Clear view" Click="ClearResultView_Click" Margin="6,0" Padding="8,4"/><TextBlock x:Name="ResultSummary" VerticalAlignment="Center"/></StackPanel><TabControl x:Name="ResultTabs" Margin="0,4"/></StackPanel>
  <TextBox x:Name="MessagesText" Grid.Row="5" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
 </Grid>
</UserControl>
