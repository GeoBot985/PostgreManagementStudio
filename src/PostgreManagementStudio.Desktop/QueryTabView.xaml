<UserControl x:Class="PostgreManagementStudio.Desktop.QueryTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Database:" VerticalAlignment="Center"/><TextBox x:Name="DatabaseText" Width="140" Margin="6,0,12,0" Text="postgres"/><TextBlock Text="Connection: PMS_CONNECTION_STRING" VerticalAlignment="Center" Opacity="0.7"/></StackPanel><TextBox x:Name="SqlText" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,8" TextChanged="SqlText_TextChanged"/><StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="ExecuteButton" Content="Execute (F5/Ctrl+Enter)" Click="Execute_Click" Padding="10,5"/><Button Content="Cancel (Esc)" Click="Cancel_Click" Margin="8,0,0,0" Padding="10,5"/><TextBlock x:Name="StatusText" Margin="12,6,0,0"/></StackPanel><ListView x:Name="RowsView" Grid.Row="3" Margin="0,8"><ListView.View><GridView><GridViewColumn Header="#" DisplayMemberBinding="{Binding RowIndex}" Width="60"/><GridViewColumn Header="Values" DisplayMemberBinding="{Binding Value}" Width="850"/></GridView></ListView.View></ListView><TextBox x:Name="MessagesText" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></Grid></UserControl>
