<UserControl x:Class="PostgreManagementStudio.Desktop.QueryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PostgreManagementStudio.Desktop"
             PreviewKeyDown="UserControl_KeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="120"/>
      <RowDefinition Height="5"/>
      <RowDefinition x:Name="OutputRow" Height="190" MinHeight="100"/>
    </Grid.RowDefinitions>

    <Border x:Name="FindPanel" Grid.Row="0" Visibility="Collapsed" Background="#F3F3F3"
            BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="6">
      <WrapPanel>
        <TextBlock Text="Find:" VerticalAlignment="Center"/>
        <TextBox x:Name="FindText" Width="180" Margin="6,0" AutomationProperties.Name="Find text"/>
        <Button Content="Find next" Command="{x:Static local:ShellCommands.FindNext}" Padding="8,3"/>
        <TextBlock x:Name="ReplaceLabel" Text="Replace:" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBox x:Name="ReplaceText" Width="180" Margin="6,0" AutomationProperties.Name="Replacement text"/>
        <Button x:Name="ReplaceAllButton" Content="Replace all" Click="ReplaceAll_Click" Padding="8,3"/>
        <Button Content="Close" Click="CloseFind_Click" Margin="12,0,0,0" Padding="8,3"/>
      </WrapPanel>
    </Border>

    <TextBox x:Name="SqlText" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="13" Padding="6"
             TextChanged="SqlText_TextChanged" SelectionChanged="SqlText_SelectionChanged"
             AutomationProperties.Name="SQL editor">
      <TextBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Undo" Command="ApplicationCommands.Undo"/>
          <MenuItem Header="Redo" Command="ApplicationCommands.Redo"/>
          <Separator/>
          <MenuItem Header="Cut" Command="ApplicationCommands.Cut"/>
          <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
          <MenuItem Header="Paste" Command="ApplicationCommands.Paste"/>
          <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
          <Separator/>
          <MenuItem Header="Execute" Command="{x:Static local:ShellCommands.Execute}"/>
          <MenuItem Header="Describe Object" Command="{x:Static local:ShellCommands.DescribeObject}" InputGestureText="Alt+F1"/>
          <MenuItem Header="Display Estimated Plan" Command="{x:Static local:ShellCommands.EstimatedPlan}"/>
        </ContextMenu>
      </TextBox.ContextMenu>
    </TextBox>

    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="#E5E5E5" ResizeDirection="Rows"/>

    <TabControl x:Name="OutputTabs" Grid.Row="3" AutomationProperties.Name="Query output">
      <TabItem Header="Results">
        <DockPanel>
          <ToolBar DockPanel.Dock="Top" Header="Results" AutomationProperties.Name="Results toolbar">
            <Button Command="{x:Static local:ShellCommands.CopyResults}" ToolTip="Copy selected rows" AutomationProperties.Name="Copy results"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;"/></Button>
            <Button Command="{x:Static local:ShellCommands.CopyResultsWithHeaders}" ToolTip="Copy selected rows with headers" AutomationProperties.Name="Copy results with headers"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B0;"/></Button>
            <Button Command="{x:Static local:ShellCommands.ExportResults}" ToolTip="Export results" AutomationProperties.Name="Export results"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDE1;"/></Button>
            <Separator/>
            <Button Command="{x:Static local:ShellCommands.FindInResults}" ToolTip="Find in results" AutomationProperties.Name="Find in results"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;"/></Button>
            <Button Command="{x:Static local:ShellCommands.ClearResults}" ToolTip="Clear result sorting and search" AutomationProperties.Name="Clear result view"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE894;"/></Button>
            <Separator/>
            <Button x:Name="PreviousResultPageButton" Content="Previous" Click="PreviousResultPage_Click"
                    ToolTip="Show the previous bounded result page"/>
            <Button x:Name="NextResultPageButton" Content="Next" Click="NextResultPage_Click"
                    ToolTip="Show the next bounded result page"/>
            <Separator/>
            <TextBlock x:Name="ResultSummary" VerticalAlignment="Center" Margin="4,0"/>
          </ToolBar>
          <Border x:Name="ResultSearchPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="#F7F7F7" Padding="5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Find in results:" VerticalAlignment="Center"/>
              <TextBox x:Name="ResultSearchText" Width="180" Margin="6,0"/>
              <Button Content="Find" Click="ResultSearch_Click" Padding="8,3"/>
            </StackPanel>
          </Border>
          <TabControl x:Name="ResultTabs" AutomationProperties.Name="Result sets">
            <TabControl.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy" Command="{x:Static local:ShellCommands.CopyResults}"/>
                <MenuItem Header="Copy with Headers" Command="{x:Static local:ShellCommands.CopyResultsWithHeaders}"/>
                <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
                <Separator/>
                <MenuItem Header="Export…" Command="{x:Static local:ShellCommands.ExportResults}"/>
                <MenuItem Header="Find…" Command="{x:Static local:ShellCommands.FindInResults}"/>
              </ContextMenu>
            </TabControl.ContextMenu>
          </TabControl>
        </DockPanel>
      </TabItem>
      <TabItem Header="Messages">
        <TextBox x:Name="MessagesText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Padding="6" AutomationProperties.Name="Query messages"/>
      </TabItem>
      <TabItem Header="Execution Plan">
        <TabControl x:Name="PlanTabs" AutomationProperties.Name="Execution plans">
          <TextBlock Text="No execution plan is available." Margin="10" Foreground="DimGray"/>
        </TabControl>
      </TabItem>
      <TabItem x:Name="DescriptionTab" Header="Object Description">
        <DockPanel>
          <ToolBar DockPanel.Dock="Top" Header="Object description" AutomationProperties.Name="Object description toolbar">
            <TextBlock Text="Preset:" VerticalAlignment="Center"/>
            <ComboBox x:Name="DescriptionPreset" Width="125" SelectedIndex="0" SelectionChanged="DescriptionPreset_SelectionChanged"
                      AutomationProperties.Name="Column preset">
              <ComboBoxItem Content="All visible"/>
              <ComboBoxItem Content="Writable"/>
              <ComboBoxItem Content="Required insert"/>
              <ComboBoxItem Content="Key columns"/>
              <ComboBoxItem Content="Non-large"/>
            </ComboBox>
            <Button Content="All" Click="DescriptionSelectAll_Click" ToolTip="Include all columns"/>
            <Button Content="Clear" Click="DescriptionClear_Click" ToolTip="Exclude all columns"/>
            <Button Content="Invert" Click="DescriptionInvert_Click" ToolTip="Invert included columns"/>
            <Separator/>
            <TextBlock Text="Filter:" VerticalAlignment="Center"/>
            <TextBox x:Name="DescriptionFilter" Width="110" TextChanged="DescriptionFilter_TextChanged"
                     AutomationProperties.Name="Filter described columns"/>
            <Separator/>
            <ComboBox x:Name="DescriptionFormat" Width="145" SelectedIndex="2" AutomationProperties.Name="Column-list format">
              <ComboBoxItem Content="Horizontal"/>
              <ComboBoxItem Content="Vertical"/>
              <ComboBoxItem Content="SELECT list"/>
              <ComboBoxItem Content="Qualified SELECT"/>
              <ComboBoxItem Content="Quoted SELECT"/>
              <ComboBoxItem Content="Qualified quoted"/>
            </ComboBox>
            <Button Content="Copy" Click="DescriptionCopy_Click"/>
            <Button Content="Insert" Click="DescriptionInsert_Click"/>
            <Button Content="Replace *" Click="DescriptionReplaceWildcard_Click"/>
          </ToolBar>
          <TextBlock x:Name="DescriptionSummary" DockPanel.Dock="Top" Margin="7,5" Text="Press Alt+F1 on an object name."
                     AutomationProperties.Name="Object description summary"/>
          <TabControl x:Name="DescriptionModes">
            <TabItem Header="Columns">
              <DataGrid x:Name="DescriptionColumns" AutoGenerateColumns="False" IsReadOnly="False"
                        CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
                        PreviewKeyDown="DescriptionColumns_PreviewKeyDown"
                        AutomationProperties.Name="Object columns">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="Use" Binding="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="42"/>
                  <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" IsReadOnly="True" Width="42"/>
                  <DataGridTextColumn Header="Column" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                  <DataGridTextColumn Header="Data type" Binding="{Binding DataType}" IsReadOnly="True" Width="1.4*"/>
                  <DataGridTextColumn Header="Nullable" Binding="{Binding NullableText}" IsReadOnly="True" Width="68"/>
                  <DataGridTextColumn Header="Default / generated" Binding="{Binding DefaultText}" IsReadOnly="True" Width="1.2*"/>
                  <DataGridTextColumn Header="Key" Binding="{Binding KeyText}" IsReadOnly="True" Width="65"/>
                  <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="Text">
              <TextBox x:Name="DescriptionText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                       FontFamily="Consolas" Padding="6" VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Plain text object description"/>
            </TabItem>
            <TabItem Header="Definition">
              <TextBox x:Name="DescriptionDefinition" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                       FontFamily="Consolas" Padding="6" VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Object definition"/>
            </TabItem>
          </TabControl>
        </DockPanel>
      </TabItem>
    </TabControl>

    <!-- Compatibility state elements retained off-surface while command ownership moves to the shell. -->
    <Button x:Name="ExecuteButton" Visibility="Collapsed"/>
    <Button x:Name="CancelButton" Visibility="Collapsed"/>
    <TextBox x:Name="DatabaseText" Visibility="Collapsed"/>
    <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
  </Grid>
</UserControl>
